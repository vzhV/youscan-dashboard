# Runtime environment: local | test | production
ENVIRONMENT=local
# Application database (production: Supabase transaction pooler on :6543)
DATABASE_URL=postgresql+psycopg://dashboard:dashboard@localhost:54329/dashboard
# Alembic connection (production: Supabase session pooler on :5432); falls back to DATABASE_URL when empty
MIGRATIONS_DATABASE_URL=
# Database the integration tests run against
TEST_DATABASE_URL=postgresql+psycopg://dashboard:dashboard@localhost:54329/dashboard_test
# SQLAlchemy pool size per process
DB_POOL_SIZE=5
# Extra connections allowed above the pool size
DB_MAX_OVERFLOW=5
# Set true behind a transaction pooler, which does not support prepared statements
DB_DISABLE_PREPARED_STATEMENTS=false
# Maximum accepted upload size in megabytes (Vercel caps request bodies at 4.5 MB)
MAX_UPLOAD_MB=4
# Python logging level
LOG_LEVEL=INFO
